    "@solana-program/system": "^0.12.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@solana-program/compute-budget": "^0.15.0",
    "@solana-program/system": "^0.12.2",
    "@solana/kit": "^6.9.0",
    "typescript": "^6"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
