{
  "name": "@blueshift-gg/doppler-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "CLI for generating and deploying custom Doppler program artifacts",
  "bin": {
    "doppler": "./dist/cli.js",
    "doppler-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rolldown -c --clean-dir",
    "cli": "bun run build && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "bun test",
    "test:integration": "cargo test -p doppler-cli-integration",
    "prepublishOnly": "bun run --cwd ../.. packages:check"
  },
  "dependencies": {
    "@blueshift-gg/doppler": "workspace:*",
    "@solana/web3.js": "3.0.0-rc.2",
    "commander": "^15.0.0",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "rolldown": "^1.1.0",
    "rolldown-plugin-dts": "^0.25.2",
    "typescript": "^6.0.3"
  }
}
