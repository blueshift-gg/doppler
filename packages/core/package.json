{
  "name": "@blueshift-gg/doppler-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core Doppler payload, manifest, SDK, bytecode, and deploy transaction APIs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "rolldown -c --clean-dir",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@blueshift-gg/sbpf-assembler": "^0.1.9",
    "@solana-program/loader-v3": "^0.3.0",
    "@solana/codecs": "^6.9.0",
    "@solana/compat": "^6.9.0",
    "@solana/kit": "^6.9.0",
    "@solana/web3.js": "3.0.0-rc.1",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "rolldown": "^1.1.0",
    "rolldown-plugin-dts": "^0.25.2",
    "typescript": "^6.0.3"
  }
}
