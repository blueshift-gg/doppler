{
  "name": "@blueshift-gg/doppler-codec",
  "version": "0.0.3",
  "type": "module",
  "description": "Doppler payload schema and codec helpers",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rolldown -c --clean-dir",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run --cwd ../.. packages:check"
  },
  "dependencies": {
    "@solana/codecs": "^6.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "rolldown": "^1.1.0",
    "rolldown-plugin-dts": "^0.25.2",
    "typescript": "^6.0.3"
  }
}
