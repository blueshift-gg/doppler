{
  "name": "@blueshift-gg/doppler-generator",
  "version": "0.1.0",
  "type": "module",
  "description": "Schema-driven Doppler bytecode and SDK generator",
  "bin": {
    "doppler-generator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "templates", "README.md"],
  "scripts": {
    "build": "rolldown -c --clean-dir",
    "cli": "bun run build && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "bun test",
    "test:integration": "cargo test -p doppler-generator-integration",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@blueshift-gg/sbpf-assembler": "^0.1.9",
    "@solana-program/loader-v3": "^0.3.0",
    "@solana/codecs": "^6.9.0",
    "@solana/compat": "^6.9.0",
    "@solana/kit": "^6.9.0",
    "@solana/web3.js": "3.0.0-rc.1",
    "bs58": "^6.0.0",
    "commander": "^15.0.0",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "bun-types": "^1.3.14",
    "rolldown": "^1.1.0",
    "rolldown-plugin-dts": "^0.25.2",
    "typescript": "^6.0.3"
  }
}
